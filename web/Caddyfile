# Wanderer web edge: serves the built app and proxies the API to the Go gateway.
# SITE_ADDRESS is ":80" locally (plain HTTP) and the public hostname in production,
# where Caddy obtains and renews the HTTPS certificate on its own.
{
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# The public deployment only publishes port 443 (port 80 belongs to another
	# service on the host), so the certificate comes via the TLS-ALPN challenge.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy gateway:8080 {
			flush_interval -1
		}
	}

	handle /ws* {
		reverse_proxy gateway:8080
	}

	handle {
		root * /srv
		@assets path /assets/* /fonts/* /textures/* /img/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
