[Unit]
Description=Wanderer pull-based deploy (checks GitHub, rebuilds when CI passed)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
Environment=REPO_DIR=/home/ubuntu/wanderer
ExecStart=/home/ubuntu/wanderer/deploy/poll-deploy.sh
TimeoutStartSec=1800
